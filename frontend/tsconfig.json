{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    // "module": "esnext",
    "moduleResolution": "bundler",
    // "target": "ES2020",
    // "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // "types": ["svelte"],
    // "extends": "./.svelte-kit/tsconfig.json",
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "checkJs": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "rootDir": "./src",
    "ignoreDeprecations": "6.0"
    // "paths": {
    //   "$lib/*": ["./src/lib/*"]
    // }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    // "src/lib/telegram.ts"
  ]
}
